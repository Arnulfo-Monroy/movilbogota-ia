# Copie este archivo como .env y complete los valores. NO suba .env a GitHub.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo de Gemini a usar (verifique en la documentación que siga disponible)
GEMINI_MODEL=gemini-3.5-flash-lite

# Clave de Geoapify (https://www.geoapify.com/)
GEOAPIFY_API_KEY=

PORT=3000
DB_PATH=./data/app.db
